#!/bin/bash

# Pre-commit hook for PHP static analysis
# Installed by mechemsi/static-rules package
# Runs phpcbf, phpstan, and phpmd on staged PHP files

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get list of staged PHP files (only in src/ directory)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/.*\.php$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No PHP files staged in src/, skipping checks.${NC}"
    exit 0
fi

echo -e "${YELLOW}Running pre-commit checks on staged PHP files...${NC}"
echo "$STAGED_FILES"
echo ""

# Track if any tool fails
FAILED=0

# 1. Run PHP Code Beautifier and Fixer (phpcbf) - auto-fix style issues
echo -e "${YELLOW}[1/3] Running phpcbf (auto-fixing style issues)...${NC}"
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        vendor/bin/phpcbf --standard=phpcs.xml "$FILE" 2>/dev/null || true
        # Re-add the file if it was modified
        git add "$FILE"
    fi
done
echo -e "${GREEN}✓ phpcbf complete${NC}"
echo ""

# 2. Run PHPStan
echo -e "${YELLOW}[2/3] Running PHPStan...${NC}"
PHPSTAN_OUTPUT=$(vendor/bin/phpstan analyse --no-progress --error-format=raw $STAGED_FILES 2>&1) || PHPSTAN_EXIT=$?
if [ "${PHPSTAN_EXIT:-0}" -ne 0 ]; then
    echo -e "${RED}✗ PHPStan found errors:${NC}"
    echo "$PHPSTAN_OUTPUT"
    FAILED=1
else
    echo -e "${GREEN}✓ PHPStan passed${NC}"
fi
echo ""

# 3. Run PHPMD
echo -e "${YELLOW}[3/3] Running PHPMD...${NC}"
PHPMD_FAILED=0
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        PHPMD_OUTPUT=$(vendor/bin/phpmd "$FILE" text phpmd.xml 2>&1) || PHPMD_EXIT=$?
        if [ "${PHPMD_EXIT:-0}" -ne 0 ] && [ -n "$PHPMD_OUTPUT" ]; then
            echo -e "${RED}✗ PHPMD issues in $FILE:${NC}"
            echo "$PHPMD_OUTPUT"
            PHPMD_FAILED=1
        fi
    fi
done

if [ "$PHPMD_FAILED" -eq 0 ]; then
    echo -e "${GREEN}✓ PHPMD passed${NC}"
else
    FAILED=1
fi
echo ""

# Final result
if [ "$FAILED" -ne 0 ]; then
    echo -e "${RED}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${RED}Pre-commit checks FAILED. Please fix the issues above.${NC}"
    echo -e "${RED}═══════════════════════════════════════════════════════════${NC}"
    exit 1
fi

echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}All pre-commit checks passed!${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
exit 0
