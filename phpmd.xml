<?xml version="1.0"?>
<ruleset name="Strict PHPMD Ruleset"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Strict PHPMD ruleset with full coverage of all rule categories.</description>

    <!-- Exclude patterns -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>var/*</exclude-pattern>
    <exclude-pattern>cache/*</exclude-pattern>
    <exclude-pattern>migrations/*</exclude-pattern>
    <exclude-pattern>tests/_output/*</exclude-pattern>
    <exclude-pattern>tests/_data/*</exclude-pattern>
    <exclude-pattern>tests/_support/_generated/*</exclude-pattern>
    <exclude-pattern>proto/*</exclude-pattern>

    <!-- ======================= -->
    <!-- Unused Code (Full)      -->
    <!-- ======================= -->
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- ======================= -->
    <!-- Clean Code (Full)       -->
    <!-- ======================= -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <priority>1</priority>
        <properties>
            <!-- Common static factory patterns allowed -->
            <property name="exceptions" value="
                Symfony\Component\Uid\Uuid,
                Symfony\Component\Intl\Countries,
                Symfony\Component\Intl\Locales,
                Carbon\Carbon,
                Carbon\CarbonImmutable,
                DateTime,
                DateTimeImmutable
            "/>
            <property name="ignorepattern" value="/^create/i"/>
        </properties>
    </rule>

    <!-- ======================= -->
    <!-- Controversial (Full)    -->
    <!-- ======================= -->
    <rule ref="rulesets/controversial.xml"/>

    <!-- ======================= -->
    <!-- Naming Rules            -->
    <!-- ======================= -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <priority>3</priority>
        <properties>
            <property name="minimum" value="2"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongVariable">
        <priority>3</priority>
        <properties>
            <property name="maximum" value="30"/>
        </properties>
    </rule>

    <!-- ======================= -->
    <!-- Design Rules            -->
    <!-- ======================= -->
    <rule ref="rulesets/design.xml">
        <exclude name="DevelopmentCodeFragment"/>
        <exclude name="CouplingBetweenObjects"/>
    </rule>
    <rule ref="rulesets/design.xml/DevelopmentCodeFragment">
        <priority>1</priority>
        <properties>
            <property name="unwanted-functions" value="var_dump,print_r,debug_zval_dump,debug_print_backtrace,dump,dd"/>
            <property name="ignore-namespaces" value="true"/>
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="25"/>
        </properties>
    </rule>

    <!-- ======================= -->
    <!-- Code Size Rules         -->
    <!-- ======================= -->
    <rule ref="rulesets/codesize.xml">
        <exclude name="CyclomaticComplexity"/>
        <exclude name="ExcessiveParameterList"/>
    </rule>
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <priority>2</priority>
        <properties>
            <property name="reportLevel" value="5"/>
            <property name="showClassesComplexity" value="true"/>
            <property name="showMethodsComplexity" value="true"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <priority>3</priority>
        <properties>
            <property name="minimum" value="10"/>
        </properties>
    </rule>
</ruleset>
