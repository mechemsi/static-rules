parameters:
    level: max
    checkGenericClassInNonGenericObjectType: false
    checkExplicitMixed: false

    excludePaths:
        - */vendor/*
        - */proto/*
        - */tests/_data/*
        - */tests/_output/*
        - */tests/_support/_generated/*
        - */*.html.php
        - */*.json.php

    ignoreErrors:
        # Add project-specific ignores here

