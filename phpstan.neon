parameters:
    level: max
    paths:
        - src

    excludePaths:
        - */vendor/*
        - */proto/*
        - */tests/_data/*
        - */tests/_output/*
        - */tests/_support/_generated/*
        - */*.html.php
        - */*.json.php
        - */Scripts/*  # Composer scripts use Composer classes not in autoload

    ignoreErrors:
        # Add project-specific ignores here

